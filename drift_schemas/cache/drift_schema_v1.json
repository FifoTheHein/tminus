  "fixed_sql": [
    {
      "name": "occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"occurrences\" (\"occurrence_key\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL, \"uid\" TEXT NOT NULL, \"original_start_utc_ms\" INTEGER NOT NULL, \"series_uid\" TEXT NULL, \"title\" TEXT NOT NULL, \"location\" TEXT NULL, \"organizer\" TEXT NULL, \"description\" TEXT NULL, \"join_url\" TEXT NULL, \"start_utc_ms\" INTEGER NOT NULL, \"end_utc_ms\" INTEGER NOT NULL, \"all_day\" INTEGER NOT NULL CHECK (\"all_day\" IN (0, 1)), \"busy_status\" TEXT NOT NULL, \"declined\" INTEGER NOT NULL CHECK (\"declined\" IN (0, 1)), \"cancelled\" INTEGER NOT NULL CHECK (\"cancelled\" IN (0, 1)), \"calendar_color\" INTEGER NOT NULL, \"warnings\" TEXT NOT NULL DEFAULT '', \"ical_uid\" TEXT NULL, PRIMARY KEY (\"occurrence_key\"));"
        }
      ]
    },
    {
      "name": "alert_history",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"alert_history\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"alert_id\" TEXT NOT NULL, \"occurrence_key\" TEXT NOT NULL, \"start_utc_ms\" INTEGER NOT NULL, \"at_utc_ms\" INTEGER NOT NULL, \"snooze_until_utc_ms\" INTEGER NULL, \"title\" TEXT NULL, UNIQUE (\"type\", \"alert_id\", \"at_utc_ms\"));"
        }
      ]
    },
    {
      "name": "sync_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source_id\" TEXT NULL, \"at_utc_ms\" INTEGER NOT NULL, \"outcome\" TEXT NOT NULL, \"message\" TEXT NULL, \"occurrence_count\" INTEGER NULL, \"duration_ms\" INTEGER NULL);"
        }
      ]
    },
    {
