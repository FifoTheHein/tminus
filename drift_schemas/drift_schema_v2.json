  "fixed_sql": [
    {
      "name": "sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sources\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"device_calendar_id\" TEXT NULL, \"secure_storage_key\" TEXT NULL, \"default_profile_id\" TEXT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"last_attempt_utc_ms\" INTEGER NULL, \"last_success_utc_ms\" INTEGER NULL, \"last_error\" TEXT NULL, \"http_etag\" TEXT NULL, \"http_last_modified\" TEXT NULL, \"empty_streak\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"occurrences\" (\"occurrence_key\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL REFERENCES sources (id) ON DELETE CASCADE, \"uid\" TEXT NOT NULL, \"original_start_utc_ms\" INTEGER NOT NULL, \"series_uid\" TEXT NULL, \"title\" TEXT NOT NULL, \"location\" TEXT NULL, \"organizer\" TEXT NULL, \"description\" TEXT NULL, \"join_url\" TEXT NULL, \"start_utc_ms\" INTEGER NOT NULL, \"end_utc_ms\" INTEGER NOT NULL, \"all_day\" INTEGER NOT NULL CHECK (\"all_day\" IN (0, 1)), \"busy_status\" TEXT NOT NULL, \"declined\" INTEGER NOT NULL CHECK (\"declined\" IN (0, 1)), \"cancelled\" INTEGER NOT NULL CHECK (\"cancelled\" IN (0, 1)), \"calendar_color\" INTEGER NOT NULL, \"warnings\" TEXT NOT NULL DEFAULT '', \"ical_uid\" TEXT NULL, PRIMARY KEY (\"occurrence_key\"));"
        }
      ]
    },
    {
      "name": "overrides",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"overrides\" (\"scope\" TEXT NOT NULL, \"target\" TEXT NOT NULL, \"profile_id\" TEXT NULL, \"custom_alerts_json\" TEXT NULL, \"enabled\" INTEGER NULL CHECK (\"enabled\" IN (0, 1)), PRIMARY KEY (\"scope\", \"target\"));"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"alerts_json\" TEXT NOT NULL, \"sound_json\" TEXT NOT NULL, \"rings_in_quiet_mode\" INTEGER NOT NULL CHECK (\"rings_in_quiet_mode\" IN (0, 1)), \"built_in\" INTEGER NOT NULL CHECK (\"built_in\" IN (0, 1)), \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rules\" (\"id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"field\" TEXT NOT NULL, \"match_type\" TEXT NOT NULL, \"pattern\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
