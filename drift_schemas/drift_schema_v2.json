        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"alert_history\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"alert_id\" TEXT NOT NULL, \"occurrence_key\" TEXT NOT NULL, \"start_utc_ms\" INTEGER NOT NULL, \"at_utc_ms\" INTEGER NOT NULL, \"snooze_until_utc_ms\" INTEGER NULL, \"title\" TEXT NULL, UNIQUE (\"type\", \"alert_id\", \"at_utc_ms\"));"
