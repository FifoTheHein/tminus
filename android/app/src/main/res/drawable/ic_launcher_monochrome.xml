<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon for themed icons (Android 13 and later): the same shapes as
  ic_launcher_foreground.xml in opaque white, which the launcher tints. The
  track is drawn at alpha 0.3.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Track -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 54,80 A26,26 0 1,1 54,28"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.3"
        android:strokeWidth="9" />
    <!-- Arc -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 28,54"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="9" />
    <!-- T- mark: the bar, the stem and the minus -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38.325,44.65h18.7v4.4h-18.7z M45.475,44.65h4.4v18.7h-4.4z M59.775,52.35h9.9v4.4h-9.9z" />
</vector>
