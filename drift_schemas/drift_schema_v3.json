        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quiet_state\" (\"id\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"until_utc_ms\" INTEGER NULL, \"first_day\" TEXT NULL, \"last_day\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
